    "cn": "^0.5.2",
    "date-fns": "4.4.0",
    "drizzle-orm": "0.45.4",
    "jose": "6.2.15",
    "lucide-react": "1.68.0",
    "next": "16.4.5",
    "next-themes": "^0.4.6",
    "nodemailer": "10.2.1",
    "pg": "8.23.1",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
