# Conexión a PostgreSQL (docker compose up -d db)
DATABASE_URL=postgres://citaclara:citaclara@localhost:5432/citaclara

# Secreto para firmar la cookie de sesión (mínimo 32 caracteres)
SESION_SECRETO=cambia-esto-por-un-secreto-largo-y-aleatorio

# Clave del panel de la clínica de demostración (usada por pnpm seed)
CLAVE_DEMO=eleva-demo

# Opcional: fija «ahora» para pruebas y demostraciones (ISO 8601 con zona)
# CITACLARA_AHORA=2026-11-09T12:10:00+01:00
CITACLARA_AHORA=

# Recordatorios de cita (spec 003): base del enlace personal del paciente y remitente
URL_PUBLICA=http://localhost:3000
CORREO_REMITENTE=recordatorios@clinicaeleva.example
# Sin SMTP_URL, modo simulado: los correos se guardan como .eml en SALIDA_CORREO_DIR
# SMTP_URL=smtps://usuario:clave@smtp.ejemplo.es:465
# SALIDA_CORREO_DIR=datos/salida-correo
